# User-layer Codex execution policy.

prefix_rule(
    pattern = ["git"],
    decision = "allow",
    justification = "Git is part of the normal development workflow",
    match = [
        "git status --short",
        "git checkout -b chore/example",
    ],
    not_match = [
        "gh pr view 123",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Publishing branches should stay explicit",
    match = [
        "git push",
        "git push origin HEAD",
    ],
    not_match = [
        "git status --short",
    ],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "prompt",
    justification = "Recursive deletion should stay explicit",
    match = [
        "rm -rf build",
        "rm -rf .next",
    ],
    not_match = [
        "rm file.txt",
    ],
)

prefix_rule(
    pattern = ["gh"],
    decision = "prompt",
    justification = "GitHub CLI is part of the normal development workflow",
    match = [
        "gh pr view 123",
        "gh run list",
    ],
    not_match = [
        "git status --short",
    ],
)

prefix_rule(
    pattern = ["npm", "run"],
    decision = "allow",
    justification = "Package scripts are part of the normal project verification workflow",
    match = [
        "npm run build",
        "npm run lint",
    ],
    not_match = [
        "npm install",
    ],
)

prefix_rule(
    pattern = [["oxlint", "oxfmt", "curl", "just"]],
    decision = "allow",
    justification = "Common project tooling is allowed by the Claude settings",
    match = [
        "oxlint .",
        "oxfmt --check .",
        "curl --version",
        "just check",
    ],
    not_match = [
        "npm run lint",
    ],
)

prefix_rule(
    pattern = [["ls", "grep", "find", "read"]],
    decision = "allow",
    justification = "Common inspection commands are safe to run without approval",
    match = [
        "ls -la",
        "grep pattern file",
        "find . -maxdepth 1",
        "read README.md",
    ],
    not_match = [
        "git status --short",
    ],
)
